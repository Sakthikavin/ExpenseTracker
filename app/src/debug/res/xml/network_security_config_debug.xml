<?xml version="1.0" encoding="utf-8"?>
<!--
  Only takes effect when built with -PfirestoreEmulator=true (see build.gradle.kts) — an ordinary
  debug build (including the one release.yml ships) points RemoteRulesApi at production Firestore
  over HTTPS and never touches these hosts. 10.0.2.2 is the Android emulator's alias for the host
  machine's loopback; 127.0.0.1 is reached via `adb reverse`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
